---
/**
 * MatchLayout: the isolated shell for the paid-traffic /match/ funnel.
 *
 * Deliberately NOT BaseLayout/LandingLayout: this surface has its own design system
 * (src/styles/match.css, its own Tailwind root scoped with @source), no site header,
 * no site footer, no nav leaks. Only Google Ads traffic lands here; every page is noindex.
 *
 * Tracking is identical in DATA to the rest of the site (GA4 G-W92EXVZW3P + Ads
 * AW-18416211451) but the 146KB gtag.js library is injected at window load through the
 * inline dataLayer stub, so config + conversion events queue and flush unchanged while
 * nothing third-party sits on the LCP path (proven pattern: +14 mobile Lighthouse points on
 * the ILD funnel). Hotjar (site 6753255) is deferred the same way and stays prod-only.
 */
import '../styles/match.css';

interface Props {
  title: string;
  description: string;
  /** Paid-only surface: default noindex. Never flip this to index without a reason. */
  noIndex?: boolean;
  ogImage?: string;
  bodyClass?: string;
}

const {
  title,
  description,
  noIndex = true,
  ogImage = '/og-default.png',
  bodyClass = '',
} = Astro.props;

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://dscrbroker.com';
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const fullOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
const isProd = import.meta.env.PROD;

// GA4 + Ads config queue immediately; the library itself arrives after window load.
const gtagBoot = `
window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', 'G-W92EXVZW3P');
gtag('config', 'AW-18416211451');
window.addEventListener('load', function () {
  var s = document.createElement('script');
  s.async = true;
  s.src = 'https://www.googletagmanager.com/gtag/js?id=G-W92EXVZW3P';
  document.head.appendChild(s);
}, { once: true });
`;

const hotjarBoot = `
window.addEventListener('load', function () {
  (function(h,o,t,j,a,r){
    h.hj=h.hj||function(){(h.hj.q=h.hj.q||[]).push(arguments)};
    h._hjSettings={hjid:6753255,hjsv:6};
    a=o.getElementsByTagName('head')[0];
    r=o.createElement('script');r.async=1;
    r.src=t+h._hjSettings.hjid+j+h._hjSettings.hjsv;
    a.appendChild(r);
  })(window,document,'https://static.hotjar.com/c/hotjar-','.js?sv=');
}, { once: true });
`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noIndex ? 'noindex, nofollow' : 'index, follow'} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DSCRBroker.com" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <script is:inline set:html={gtagBoot} />
    {isProd && <script is:inline set:html={hotjarBoot} />}

    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
