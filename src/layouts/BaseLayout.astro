---
import '../styles/global.css';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import Hotjar from '../components/global/Hotjar.astro';
import AfterPaint from '../components/global/AfterPaint.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  jsonLd?: object;
  noIndex?: boolean;
  /**
   * Learn pages skip Hotjar (Tanner's call 2026-08-18): heatmaps matter on
   * conversion surfaces, not education pages, and its script sits in the
   * article LCP graph. gtag (GA4 + Ads) always loads regardless. Defaults to
   * false, so every existing page keeps recording exactly as before.
   */
  skipHotjar?: boolean;
}

const {
  title,
  description,
  canonical = Astro.url.href,
  ogImage = '/og-default.png',
  ogType = 'website',
  jsonLd,
  noIndex = false,
  skipHotjar = false,
} = Astro.props;

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://dscrbroker.com';
const fullOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />

  {noIndex ? (
    <meta name="robots" content="noindex, nofollow" />
  ) : (
    <meta name="robots" content="index, follow" />
  )}

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={fullOgImage} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="DSCRBroker.com" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={fullOgImage} />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Inter is self-hosted site-wide (@font-face in global.css), no Google Fonts chain -->

  <!-- JSON-LD Structured Data -->
  {jsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )}

  <!-- Shared afterPaint() gate for gtag, Hotjar and homepage motion -->
  <AfterPaint />

  <!-- Google tag (gtag.js): GA4 + Google Ads. The AW config registers the Ads
       destination so the thank-you page's conversion event (send_to AW-18416211451)
       is actually delivered instead of silently dropped.
       The inline dataLayer/gtag() queue runs immediately; the library itself is
       injected by afterPaint (load + first paint, then idle) so its ~337KB
       (GA4 + the Ads container) stays out of the LCP graph. Config, page_view
       and the thank-you conversion all queue in dataLayer and flush unchanged
       when the library lands. -->
  <script is:inline set:html={`
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-W92EXVZW3P');
    gtag('config', 'AW-18416211451');
    afterPaint(function(){
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=G-W92EXVZW3P';
      document.head.appendChild(s);
    });
  `} />

  <!-- Google Tag Manager -->
  {import.meta.env.PUBLIC_GTM_ID && (
    <script set:html={`
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','${import.meta.env.PUBLIC_GTM_ID}');
    `} />
  )}

  <!-- Hotjar: session recordings + heatmaps -->
  {!skipHotjar && <Hotjar />}

  <slot name="head" />
</head>
<body class="min-h-screen bg-off-white font-sans text-navy">
  {/* GTM noscript fallback */}
  {import.meta.env.PUBLIC_GTM_ID && (
    <noscript>
      <iframe
        src={`https://www.googletagmanager.com/ns.html?id=${import.meta.env.PUBLIC_GTM_ID}`}
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe>
    </noscript>
  )}

  <Header />

  <main>
    <slot />
  </main>

  <Footer />
</body>
</html>
