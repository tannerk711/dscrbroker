---
/**
 * Article shell for /learn/[slug]/ pages.
 * Dark header band (breadcrumb + category + H1 + honest dates), direct-answer
 * card pulled up over the fold line, prose + sticky TOC grid, FAQ accordion,
 * related guides, dark end-CTA band, sticky mobile CTA.
 * Schema: Article + BreadcrumbList + FAQPage, trailing-slash URLs matching
 * the canonical exactly.
 */
import '../styles/learn.css';
import BaseLayout from './BaseLayout.astro';
import CategoryBadge from '../components/learn/CategoryBadge.astro';
import DirectAnswer from '../components/learn/DirectAnswer.astro';
import ArticleTOC from '../components/learn/ArticleTOC.astro';
import RelatedGuides from '../components/learn/RelatedGuides.astro';
import StickyContentCTA from '../components/learn/StickyContentCTA.astro';
import FAQAccordion from '../components/FAQAccordion';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';

interface Props {
  entry: CollectionEntry<'learn'>;
  headings: MarkdownHeading[];
  relatedEntries: {
    id: string;
    title: string;
    description: string;
    category: 'basics' | 'programs' | 'strategy' | 'market';
    readTime: number;
  }[];
}

const { entry, headings, relatedEntries } = Astro.props;
const { title, metaTitle, description, publishDate, updatedDate, category, keywords, readTime, directAnswer, faqs, moneyLink, endCta } =
  entry.data;

const canonical = `https://dscrbroker.com/learn/${entry.id}/`;
const pageTitle = `${metaTitle ?? title} | DSCRBroker.com`;

/* Frontmatter dates parse as UTC midnight; format in UTC or the shown date
   drifts a day behind on US-timezone builds. */
const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const isoDate = (d: Date) => d.toISOString().split('T')[0];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    datePublished: isoDate(publishDate),
    dateModified: isoDate(updatedDate ?? publishDate),
    keywords: keywords.join(', '),
    author: { '@type': 'Organization', name: 'DSCRBroker.com', url: 'https://dscrbroker.com/' },
    publisher: {
      '@type': 'Organization',
      name: 'DSCRBroker.com',
      url: 'https://dscrbroker.com/',
      logo: { '@type': 'ImageObject', url: 'https://dscrbroker.com/og-default.png' },
    },
    image: 'https://dscrbroker.com/og-default.png',
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://dscrbroker.com/' },
      { '@type': 'ListItem', position: 2, name: 'Learn', item: 'https://dscrbroker.com/learn/' },
      { '@type': 'ListItem', position: 3, name: title, item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: { '@type': 'Answer', text: f.answer },
    })),
  },
];
---

<BaseLayout
  title={pageTitle}
  description={description}
  canonical={canonical}
  ogType="article"
  jsonLd={jsonLd}
  selfHostFonts
  skipHotjar
>
  <!-- Same-origin font preload: lands Inter before first paint so the text
       LCP carries no late-font dependency (font-display: optional then makes
       first paint final either way). crossorigin required: font fetches are
       CORS-mode even same-origin, a mismatched preload double-downloads. -->
  <link
    slot="head"
    rel="preload"
    as="font"
    type="font/woff2"
    crossorigin
    href="/fonts/inter-latin-wght-normal.woff2"
  />
  <!-- Dark article header band -->
  <section class="relative overflow-hidden bg-navy pt-24 pb-20 md:pt-36 md:pb-28">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,#131C31_0%,#0B1120_65%)]"></div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <nav class="flex flex-wrap items-center gap-2 text-sm text-slate-400" aria-label="Breadcrumb">
        <a href="/" class="transition-colors hover:text-white">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/learn/" class="transition-colors hover:text-white">Learn</a>
        <span aria-hidden="true">/</span>
        <span class="text-slate-300">{title}</span>
      </nav>

      <div class="mt-6 max-w-3xl">
        <CategoryBadge category={category} onDark />
        <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-white md:text-5xl" style="line-height: 1.12; letter-spacing: -0.008em;">
          {title}
        </h1>
        <p class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-slate-400">
          <span>By DSCRBroker.com</span>
          <span aria-hidden="true">·</span>
          <span>Published {fmtDate(publishDate)}</span>
          {updatedDate && (
            <>
              <span aria-hidden="true">·</span>
              <span>Updated {fmtDate(updatedDate)}</span>
            </>
          )}
          <span aria-hidden="true">·</span>
          <span>{readTime} min read</span>
        </p>
      </div>
    </div>
  </section>

  <!-- Body: direct answer pulled up over the band edge, then prose + TOC -->
  <section class="bg-off-white pb-16 md:pb-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- grid-cols-1 matters: an implicit auto track sizes to max-content, so
           the 560px-min table would push the column past a 390px viewport and
           clip every paragraph. minmax(0,1fr) keeps wide children scrolling
           inside their own containers instead. -->
      <div class="grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1fr)_264px] lg:gap-14">
        <div class="max-w-3xl">
          <!-- relative is load-bearing: the dark band above is positioned, so a
               static card pulled up with negative margin paints UNDER it (the
               label was clipped and the band showed a dead dark zone). -->
          <div class="relative -mt-12 md:-mt-16">
            <DirectAnswer>{directAnswer}</DirectAnswer>
          </div>
          <div class="mt-10 lg:hidden">
            <ArticleTOC headings={headings} />
          </div>
          <article class="learn-prose mt-10" style="content-visibility: auto; contain-intrinsic-size: auto 6000px;">
            <slot />
          </article>
        </div>
        <aside class="hidden lg:block">
          <div class="mt-10">
            <ArticleTOC headings={headings} />
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="cv-auto border-t border-gray-200 bg-white py-14 md:py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <div class="lr-reveal text-center">
        <p class="text-xs font-semibold uppercase tracking-widest text-amber-dark">Straight answers</p>
        <h2 class="mt-2 text-2xl font-bold tracking-tight text-navy md:text-3xl">Investor questions</h2>
      </div>
      <div class="lr-reveal mt-8">
        <FAQAccordion client:visible items={faqs} />
      </div>
    </div>
  </section>

  <RelatedGuides entries={relatedEntries} moneyLink={moneyLink} />

  <!-- End CTA band -->
  <section class="cv-auto bg-navy py-16 md:py-24">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
      <div class="lr-reveal">
        <p class="text-xs font-semibold uppercase tracking-widest text-amber">Next step</p>
        <h2 class="mt-2 text-2xl font-bold tracking-tight text-white sm:text-3xl md:text-4xl" style="line-height: 1.15;">
          {endCta.headline}
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-lg leading-relaxed text-slate-300">{endCta.body}</p>
        <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a
            href="/qualify/"
            class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-blue px-8 py-4 text-lg font-bold text-white transition-all hover:bg-blue-dark hover:shadow-lg sm:w-auto"
          >
            Match Me With a Specialist
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m0 0l-7-7m7 7l-7 7" />
            </svg>
          </a>
          <a
            href="/analyze/"
            class="inline-flex w-full items-center justify-center rounded-lg border-2 border-slate-500 px-6 py-[14px] text-base font-semibold text-white transition-colors hover:border-blue hover:text-blue-light sm:w-auto"
          >
            Analyze My Deal
          </a>
        </div>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3 text-sm text-slate-300 sm:gap-6">
          <span class="flex items-center gap-2">
            <svg class="h-4 w-4 text-green" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
            2-minute form
          </span>
          <span class="flex items-center gap-2">
            <svg class="h-4 w-4 text-green" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
            No SSN. No credit pull.
          </span>
          <span class="flex items-center gap-2">
            <svg class="h-4 w-4 text-green" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
            70+ lenders in network
          </span>
        </div>
      </div>
    </div>
  </section>

  <StickyContentCTA />

  <!-- Below-fold reveal motion: IntersectionObserver + CSS transitions only.
       Elements are visible pre-JS; anything already on screen at load is
       skipped, so nothing flashes and the LCP element never waits. -->
  <script>
    window.addEventListener('load', () => {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      if (!('IntersectionObserver' in window)) return;
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('lr-in');
              io.unobserve(entry.target);
            }
          });
        },
        { rootMargin: '0px 0px -10% 0px' }
      );
      const vh = window.innerHeight;
      document.querySelectorAll<HTMLElement>('.lr-reveal').forEach((el) => {
        if (el.getBoundingClientRect().top < vh * 0.92) return; // already visible, leave it
        el.classList.add('lr-prep');
        io.observe(el);
      });
    });
  </script>
</BaseLayout>
