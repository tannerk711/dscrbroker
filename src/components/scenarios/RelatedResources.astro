---
/**
 * Cross-link cards for scenario pages. Unlike the learn section's
 * RelatedGuides (which is bound to the learn collection), these take free-form
 * links so a scenario page can point at learn articles, program pages, and
 * sibling scenarios in one row. Part of the no-orphan linking mesh.
 */
interface Props {
  links: { href: string; title: string; blurb: string; tag: string }[];
}
const { links } = Astro.props;
---

<section class="cv-auto border-t border-gray-200 bg-off-white py-14 md:py-20">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <div class="lr-reveal">
      <p class="text-xs font-semibold uppercase tracking-widest text-amber-dark">Keep going</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-navy md:text-3xl">Related reading</h2>
    </div>
    <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {links.map((link) => (
        <a
          href={link.href}
          class="lr-reveal group flex flex-col rounded-xl border border-gray-200 bg-white p-6 shadow-sm transition-all hover:-translate-y-0.5 hover:border-blue/30 hover:shadow-md"
        >
          <span class="text-xs font-semibold uppercase tracking-widest text-blue-dark">{link.tag}</span>
          <span class="mt-2 text-lg font-bold leading-snug tracking-tight text-navy transition-colors group-hover:text-blue-dark">
            {link.title}
          </span>
          <span class="mt-2 text-sm leading-relaxed text-gray-500">{link.blurb}</span>
          <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-blue">
            Read it
            <svg class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
