---
/**
 * Phone-free sticky mobile CTA for content pages (/learn/, /dscr-loans/,
 * /states/ and city pages). Variant of lp/StickyMobileCTA.astro: single
 * full-width button to /qualify/, same show-after-600px logic. The directory
 * has no phone number. Hides while the page footer or any element marked
 * data-sticky-cta-hide (the final-CTA band) is on screen, so it never covers
 * the band's own button or the footer links.
 */
interface Props {
  /** Analytics data-location value: sticky_learn | sticky_scenario | sticky_state | sticky_city. */
  location?: string;
}
const { location = 'sticky_learn' } = Astro.props;
---

<!-- Mobile-only sticky bottom CTA bar. Appears after scrolling past 600px. -->
<div
  id="sticky-content-cta"
  class="sticky-mobile-chrome fixed bottom-0 left-0 right-0 z-40 lg:hidden bg-navy/95 backdrop-blur-md border-t border-white/[0.08] px-3 py-3 transform translate-y-full transition-transform duration-300"
>
  <div class="mx-auto max-w-md">
    <a
      href="/qualify/"
      data-event="scroll_to_form"
      data-location={location}
      class="flex items-center justify-center gap-2 rounded-lg bg-blue py-3 text-sm font-semibold text-white active:bg-blue-dark"
    >
      Match Me With a Specialist
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </a>
  </div>
</div>

<script>
  // Tailwind v4's translate-y-full compiles to the CSS `translate` property,
  // so the JS override MUST set style.translate (style.transform never wins).
  const stickyEl = document.getElementById('sticky-content-cta');
  if (stickyEl) {
    let visible = false;
    let blocked = false; // footer or final-CTA band on screen
    const apply = () => {
      const shouldShow = window.scrollY > 600 && !blocked;
      if (shouldShow !== visible) {
        visible = shouldShow;
        stickyEl.style.translate = shouldShow ? '0 0' : '0 100%';
      }
    };
    window.addEventListener('scroll', apply, { passive: true });

    const blockers = [
      ...document.querySelectorAll('[data-sticky-cta-hide]'),
      ...document.querySelectorAll('footer'),
    ];
    if (blockers.length && 'IntersectionObserver' in window) {
      const onScreen = new Set<Element>();
      const io = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) onScreen.add(entry.target);
          else onScreen.delete(entry.target);
        }
        blocked = onScreen.size > 0;
        apply();
      });
      blockers.forEach((el) => io.observe(el));
    }
    apply();
  }
</script>
