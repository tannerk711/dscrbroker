---
/**
 * Rent-vs-PITIA visual: the PITIA stack (P&I, taxes, insurance, HOA) next to
 * the rent bar, with the gap labeled as monthly cash flow. Bars grow in when
 * scrolled into view. Every segment is directly labeled with its name and
 * dollar amount, so nothing rides on color alone. Pure SVG, no island.
 */
interface Props {
  pi: number;
  tax: number;
  insurance: number;
  hoa?: number;
  rent: number;
  caption?: string;
}
const { pi, tax, insurance, hoa = 0, rent, caption } = Astro.props;

const pitia = pi + tax + insurance + hoa;
const dscr = Math.round((rent / pitia) * 100) / 100;
const cashFlow = rent - pitia;

const fmt = (n: number) => `$${Math.round(n).toLocaleString('en-US')}`;

/* Chart geometry */
const W = 560;
const H = 300;
const BASE = 252;
const CHART_MAX = Math.max(rent, pitia);
const SCALE = 196 / CHART_MAX;

const BAR_W = 96;
const X_PITIA = 178;
const X_RENT = 344;

/* Stack segments bottom-up with a 2px gap between fills */
const segs = [
  { label: 'P&I', value: pi, color: '#0B1120' },
  { label: 'Taxes', value: tax, color: '#3B82F6' },
  { label: 'Insurance', value: insurance, color: '#D4930D' },
  ...(hoa > 0 ? [{ label: 'HOA', value: hoa, color: '#94918A' }] : []),
];
let cursor = BASE;
const stack = segs.map((s, i) => {
  const h = s.value * SCALE;
  cursor -= h;
  const y = cursor + (i > 0 ? 0 : 0);
  return { ...s, y, h: Math.max(h - 2, 2) };
});

const rentH = rent * SCALE;
const rentY = BASE - rentH;
const pitiaTop = BASE - pitia * SCALE;
---

<figure class="lr-reveal my-10 rounded-xl border border-gray-200 bg-white px-2 py-6 shadow-sm sm:px-6" data-waterfall>
  <div class="overflow-x-auto">
    <svg
      viewBox={`0 0 ${W} ${H}`}
      class="mx-auto block min-w-[480px] max-w-[640px]"
      role="img"
      aria-label={`Monthly PITIA of ${fmt(pitia)} compared to rent of ${fmt(rent)}. DSCR ${dscr.toFixed(2)}.`}
    >
      <!-- baseline -->
      <line x1="70" y1={BASE} x2={W - 40} y2={BASE} stroke="#E2E0DA" stroke-width="1.5" />

      <!-- PITIA stack -->
      {stack.map((s) => (
        <>
          <rect class="wf-bar" x={X_PITIA} y={s.y} width={BAR_W} height={s.h} rx="3" fill={s.color} />
          <text
            x={X_PITIA - 10}
            y={s.y + s.h / 2 + 3.5}
            text-anchor="end"
            class="wf-label fill-gray-500"
            style="font-size: 11px; font-weight: 500;"
          >
            {s.label} · {fmt(s.value)}
          </text>
        </>
      ))}

      <!-- PITIA total -->
      <text
        x={X_PITIA + BAR_W / 2}
        y={pitiaTop - 10}
        text-anchor="middle"
        class="wf-label fill-navy"
        style="font-size: 13px; font-weight: 700; font-variant-numeric: tabular-nums;"
      >
        PITIA {fmt(pitia)}
      </text>

      <!-- Rent bar -->
      <rect class="wf-bar" x={X_RENT} y={rentY} width={BAR_W} height={rentH} rx="3" fill="#22C55E" style="transition-delay: 0.25s;" />
      <text
        x={X_RENT + BAR_W / 2}
        y={rentY - 10}
        text-anchor="middle"
        class="wf-label fill-navy"
        style="font-size: 13px; font-weight: 700; font-variant-numeric: tabular-nums;"
      >
        Rent {fmt(rent)}
      </text>

      <!-- coverage line from PITIA top across the rent bar -->
      <line
        class="wf-label"
        x1={X_PITIA + BAR_W + 8}
        y1={pitiaTop}
        x2={X_RENT + BAR_W + 26}
        y2={pitiaTop}
        stroke="#94918A"
        stroke-width="1.5"
        stroke-dasharray="5 4"
      />

      <!-- cash flow bracket (only meaningful when rent above PITIA top differs) -->
      <text
        x={X_RENT + BAR_W + 32}
        y={(pitiaTop + rentY) / 2 + 4}
        text-anchor="start"
        class="wf-label"
        fill={cashFlow >= 0 ? '#22C55E' : '#EF4444'}
        style="font-size: 12px; font-weight: 700; font-variant-numeric: tabular-nums;"
      >
        {cashFlow >= 0 ? '+' : '−'}{fmt(Math.abs(cashFlow))}/mo
      </text>

      <!-- axis labels -->
      <text x={X_PITIA + BAR_W / 2} y={BASE + 22} text-anchor="middle" class="fill-gray-500" style="font-size: 12px; font-weight: 600;">
        The payment stack
      </text>
      <text x={X_RENT + BAR_W / 2} y={BASE + 22} text-anchor="middle" class="fill-gray-500" style="font-size: 12px; font-weight: 600;">
        What the property earns
      </text>
    </svg>
  </div>
  <figcaption class="mx-auto mt-4 max-w-lg text-center text-sm leading-relaxed text-gray-500">
    {caption ?? `Rent ${fmt(rent)} ÷ PITIA ${fmt(pitia)} = ${dscr.toFixed(2)}x DSCR.`}
  </figcaption>
</figure>

<script>
  const waterfalls = document.querySelectorAll('[data-waterfall]');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('wf-in');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.35 }
    );
    waterfalls.forEach((w) => io.observe(w));
  } else {
    waterfalls.forEach((w) => w.classList.add('wf-in'));
  }
</script>
