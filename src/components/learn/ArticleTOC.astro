---
/**
 * Table of contents from the article's H2s. Sticky sidebar on desktop,
 * collapsible accordion above the body on mobile. Scroll-spy highlights
 * the section in view (tiny IntersectionObserver, no island).
 */
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}
const { headings } = Astro.props;
const h2s = headings.filter((h) => h.depth === 2);
---

{h2s.length > 2 && (
  <>
    <!-- Mobile: collapsible TOC -->
    <details class="mb-8 rounded-xl border border-gray-200 bg-white shadow-sm lg:hidden">
      <summary class="flex cursor-pointer items-center justify-between px-5 py-4 text-sm font-bold text-navy [&::-webkit-details-marker]:hidden">
        In this guide
        <svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </summary>
      <nav class="border-t border-gray-100 px-5 py-3" aria-label="Table of contents">
        {h2s.map((h) => (
          <a href={`#${h.slug}`} class="toc-link">{h.text}</a>
        ))}
      </nav>
    </details>

    <!-- Desktop: sticky sidebar -->
    <nav
      class="hidden lg:block lg:sticky lg:top-28 lg:self-start"
      aria-label="Table of contents"
      data-toc
    >
      <p class="text-xs font-semibold uppercase tracking-widest text-gray-400">In this guide</p>
      <div class="mt-3 border-l border-gray-200">
        {h2s.map((h) => (
          <a href={`#${h.slug}`} class="toc-link -ml-px" data-toc-link={h.slug}>{h.text}</a>
        ))}
      </div>
    </nav>
  </>
)}

<script>
  // Scroll-spy: highlight the TOC link for the H2 nearest the top of the viewport.
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
  if (links.length) {
    const map = new Map<Element, HTMLAnchorElement>();
    links.forEach((link) => {
      const target = document.getElementById(link.dataset.tocLink || '');
      if (target) map.set(target, link);
    });
    let active: HTMLAnchorElement | null = null;
    const setActive = (link: HTMLAnchorElement | null) => {
      if (active === link) return;
      active?.classList.remove('is-active');
      link?.classList.add('is-active');
      active = link;
    };
    const io = new IntersectionObserver(
      (entries) => {
        // Pick the last heading that has crossed above the 40% line.
        const visible = entries.filter((e) => e.isIntersecting);
        if (visible.length) setActive(map.get(visible[visible.length - 1].target) ?? null);
      },
      { rootMargin: '-15% 0px -55% 0px' }
    );
    map.forEach((_link, target) => io.observe(target));
  }
</script>
