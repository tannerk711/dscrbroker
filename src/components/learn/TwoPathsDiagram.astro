---
/**
 * "Two ways a lender reads your file" diagram for the What Is a DSCR Loan
 * article. Conventional underwriting (you qualify the loan) vs DSCR
 * underwriting (the property qualifies the loan). HTML + inline SVG icons,
 * zero image weight.
 */
const conventional = [
  'Two years of tax returns',
  'W-2s and pay stubs',
  'Employment verification',
  'Personal debt-to-income math',
];
const dscr = [
  'Lease or appraiser market rent',
  'The property’s PITIA payment',
  'Credit score and down payment',
  'Nothing about your paycheck',
];
---

<div class="lr-reveal my-10 grid gap-4 sm:grid-cols-2">
  <!-- Conventional path -->
  <div class="flex flex-col rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
    <p class="text-xs font-semibold uppercase tracking-widest text-gray-400">Conventional underwriting</p>
    <p class="mt-1 text-lg font-bold tracking-tight text-navy">The lender qualifies you</p>
    <ul class="mt-4 flex-1 space-y-2.5">
      {conventional.map((item) => (
        <li class="flex items-start gap-2.5 text-sm text-gray-500">
          <svg class="mt-0.5 h-4 w-4 shrink-0 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6M9 8h6M5 3h14a1 1 0 011 1v16a1 1 0 01-1 1H5a1 1 0 01-1-1V4a1 1 0 011-1z" />
          </svg>
          {item}
        </li>
      ))}
    </ul>
    <div class="mt-5 rounded-lg bg-gray-100 px-4 py-3">
      <p class="text-sm font-semibold text-gray-600">Your personal income decides.</p>
    </div>
  </div>

  <!-- DSCR path -->
  <div class="flex flex-col rounded-xl border-2 border-blue/30 bg-white p-6 shadow-md">
    <p class="text-xs font-semibold uppercase tracking-widest text-blue-dark">DSCR underwriting</p>
    <p class="mt-1 text-lg font-bold tracking-tight text-navy">The lender qualifies the property</p>
    <ul class="mt-4 flex-1 space-y-2.5">
      {dscr.map((item) => (
        <li class="flex items-start gap-2.5 text-sm text-gray-500">
          <svg class="mt-0.5 h-4 w-4 shrink-0 text-green" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
          {item}
        </li>
      ))}
    </ul>
    <div class="mt-5 rounded-lg bg-blue/5 px-4 py-3">
      <p class="text-sm font-semibold text-blue-dark">The property&rsquo;s cash flow decides.</p>
    </div>
  </div>
</div>
