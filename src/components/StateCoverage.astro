---
import USMap from './USMap';
---

<section id="coverage" class="bg-white py-16 md:py-24 relative overflow-hidden">
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="mx-auto max-w-3xl text-center">
      <h2 data-gsap="heading" class="text-3xl font-bold tracking-[-0.008em] text-navy md:text-4xl">Licensed in All 50 States</h2>
      <p data-gsap="subhead" class="mt-4 text-lg text-gray-500">Hover over any state to explore DSCR loan options in your market.</p>
    </div>

    <!-- Interactive Map -->
    <div class="mt-12 mx-auto max-w-4xl">
      <USMap client:visible />
    </div>

    <!-- See all states CTA -->
    <div class="mt-8 text-center">
      <a href="/states/" class="inline-flex items-center gap-1 font-semibold text-navy-mid underline decoration-navy-mid/35 underline-offset-4 transition-colors hover:text-navy hover:decoration-navy">
        See All 50 States
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</section>
