---
import LandingLayout from '../../layouts/LandingLayout.astro';
import LPHeader from '../../components/lp/LPHeader.astro';
import HeroVirginia from '../../components/lp/HeroVirginia.astro';
import BenefitsFL from '../../components/lp/BenefitsFL.astro';
import HowItWorksVirginia from '../../components/lp/HowItWorksVirginia.astro';
import DSCRUnderwritingReality from '../../components/lp/DSCRUnderwritingReality.astro';
import TestimonialCarouselVirginia from '../../components/lp/TestimonialCarouselVirginia.tsx';
import BarrettReviews from '../../components/lp/BarrettReviews.astro';
import SpecialistCard from '../../components/lp/SpecialistCard.astro';
import ComparisonTable from '../../components/lp/ComparisonTable.astro';
import FAQAccordion from '../../components/FAQAccordion.tsx';
import FinalCTAVirginia from '../../components/lp/FinalCTAVirginia.astro';
import LPFooter from '../../components/lp/LPFooter.astro';
import StickyMobileCTA from '../../components/lp/StickyMobileCTA.astro';
import { virginiaFAQ } from '../../data/lp/virginia-faq';

const title = 'Virginia DSCR Loans, Consultative From Day One | DSCRBroker.com';
const description = "Get matched with John Peisner at Barrett Financial, a Virginia DSCR specialist with 1000+ closed loans. Military-anchored Hampton Roads, Richmond, and Northern Virginia rentals plus declined files handled. Qualify on rents, not tax returns.";

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: virginiaFAQ.map((q) => ({
    '@type': 'Question',
    name: q.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: q.answer,
    },
  })),
};

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FinancialService',
  name: 'DSCRBroker.com Virginia DSCR Specialist Matching',
  description,
  url: 'https://dscrbroker.com/lp/virginia-dscr/',
  areaServed: {
    '@type': 'State',
    name: 'Virginia',
  },
  provider: {
    '@type': 'Organization',
    name: 'DSCRBroker.com',
  },
};
---

<LandingLayout
  title={title}
  description={description}
  noIndex={true}
  hideHeader={true}
  hideFooter={true}
  jsonLd={[serviceJsonLd, faqJsonLd]}
>
  <Fragment slot="head">
    <noscript>
      <style>
        .fl-reveal, .fl-reveal-chip { opacity: 1 !important; transform: none !important; }
      </style>
    </noscript>
  </Fragment>

  <LPHeader phoneNumber="(855) 738-1557" phoneLabel="Talk to a VA DSCR Specialist" />

  <HeroVirginia />

  <!-- Comparison up front: kills "why not go direct" while cold -->
  <ComparisonTable />

  <!-- DSCR Underwriting Reality: the spine of the page -->
  <DSCRUnderwritingReality />

  <!-- Meet John AFTER the visitor knows why DSCR is hard. Anchor panel: soft blue tint frames the section. -->
  <section data-va-section="specialist" class="py-20 md:py-24" style="background: linear-gradient(180deg, rgba(59,130,246,0.04) 0%, rgba(59,130,246,0.07) 100%);">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <p class="text-xs font-medium uppercase tracking-[0.1em] text-amber mb-3">MEET YOUR SPECIALIST</p>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-navy">John Peisner, Virginia DSCR Specialist</h2>
      </div>
      <SpecialistCard
        variant="full"
        theme="light"
        title="Virginia DSCR Specialist"
        specialistLabel="Your VA Specialist"
        bio="John Peisner has closed 1000+ DSCR and non-QM loans at Barrett Financial Group, and he's the specialist real estate investors call when their first lender said no. Consultative on the first call: he walks you through entity structuring, how lenders treat military-anchored Hampton Roads rental income, local short-term rental rules, and what the lender will actually want so you know what you're working with before you write the offer."
      />
    </div>
  </section>

  <BenefitsFL />

  <HowItWorksVirginia />

  <!-- VA Deal Stories: dark navy band -->
  <section data-va-section="testimonials" class="bg-navy py-20 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <p class="text-xs font-medium uppercase tracking-[0.1em] text-amber mb-3">VIRGINIA DEAL STORIES</p>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-white">Real Virginia Deals, Real Outcomes</h2>
        <p class="mt-4 text-lg text-white/60 leading-relaxed max-w-3xl mx-auto">
          A snapshot of recent Virginia deals John and his lender network closed, including the file-rescue ones other brokers walked away from.
        </p>
      </div>
      <TestimonialCarouselVirginia client:visible />

      <!-- CTA after the testimonial emotional peak -->
      <div class="mt-12 flex flex-col items-center gap-3 sm:gap-4 sm:flex-row sm:justify-center">
        <a
          href="#lead-form"
          data-event="scroll_to_form"
          data-location="after_testimonials"
          class="inline-flex items-center justify-center rounded-lg bg-blue px-6 py-3 text-base font-semibold text-white transition-colors hover:bg-blue-dark w-full sm:w-auto"
        >
          Match Me With John
          <svg class="ml-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a
          href="tel:8557381557"
          data-event="phone_click"
          data-location="after_testimonials"
          class="inline-flex items-center justify-center gap-2 rounded-lg border border-white/15 bg-white/[0.04] px-6 py-3 text-base font-medium text-white transition-colors hover:border-blue hover:bg-blue/10 w-full sm:w-auto"
        >
          <svg class="h-5 w-5 text-amber" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h2.28a1 1 0 01.95.68l1.5 4.49a1 1 0 01-.5 1.21l-1.86.93a11 11 0 005.2 5.2l.93-1.86a1 1 0 011.21-.5l4.49 1.5a1 1 0 01.68.95V19a2 2 0 01-2 2h-1C9.72 21 3 14.28 3 6V5z" />
          </svg>
          Call (855) 738-1557
        </a>
      </div>
    </div>
  </section>

  <!-- Live Google reviews as closing third-party trust signal -->
  <BarrettReviews state="Virginia" />

  <!-- FAQ -->
  <section data-va-section="faq" class="bg-off-white py-20 md:py-24">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <p class="text-xs font-medium uppercase tracking-[0.1em] text-amber mb-3">QUESTIONS</p>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-navy">Virginia DSCR Loan Questions</h2>
        <p class="mt-4 text-base text-gray-500">The questions VA investors actually ask after their first lender said no.</p>
      </div>
      <FAQAccordion items={virginiaFAQ} client:visible />

      <!-- CTA after FAQ, before final close -->
      <div class="mt-12 flex flex-col items-center gap-3 sm:gap-4 sm:flex-row sm:justify-center">
        <a
          href="#lead-form"
          data-event="scroll_to_form"
          data-location="after_faq"
          class="inline-flex items-center justify-center rounded-lg bg-blue px-6 py-3 text-base font-semibold text-white transition-colors hover:bg-blue-dark w-full sm:w-auto"
        >
          Check My VA Deal's Eligibility
          <svg class="ml-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a
          href="tel:8557381557"
          data-event="phone_click"
          data-location="after_faq"
          class="inline-flex items-center justify-center gap-2 rounded-lg border border-gray-300 bg-white px-6 py-3 text-base font-medium text-navy transition-colors hover:border-blue hover:text-blue w-full sm:w-auto"
        >
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h2.28a1 1 0 01.95.68l1.5 4.49a1 1 0 01-.5 1.21l-1.86.93a11 11 0 005.2 5.2l.93-1.86a1 1 0 011.21-.5l4.49 1.5a1 1 0 01.68.95V19a2 2 0 01-2 2h-1C9.72 21 3 14.28 3 6V5z" />
          </svg>
          Call John Direct
        </a>
      </div>
    </div>
  </section>

  <FinalCTAVirginia phoneNumber="(855) 738-1557" />

  <LPFooter state="Virginia" />

  <StickyMobileCTA phoneNumber="(855) 738-1557" />
</LandingLayout>

<!-- GSAP-driven motion for the VA LP. Lazy-loads gsap/ScrollTrigger via dynamic import and respects prefers-reduced-motion. -->
<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce) {
    Promise.all([
      import('gsap'),
      import('gsap/ScrollTrigger'),
    ]).then(([{ default: gsap }, { ScrollTrigger }]) => {
      gsap.registerPlugin(ScrollTrigger);

      const sections = document.querySelectorAll('[data-va-section]:not([data-va-section="hero"])');
      sections.forEach((section) => {
        const heading = section.querySelector('h2');
        if (!heading) return;
        const headingBlock = heading.parentElement || heading;
        gsap.set(headingBlock, { opacity: 0, y: 24 });
        ScrollTrigger.create({
          trigger: section,
          start: 'top 80%',
          once: true,
          onEnter: () => {
            gsap.to(headingBlock, { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out' });
          },
        });
      });

      const heroBg = document.getElementById('va-hero-bg');
      if (heroBg) {
        gsap.to(heroBg, {
          yPercent: 10,
          ease: 'none',
          scrollTrigger: { trigger: '[data-va-section="hero"]', start: 'top top', end: 'bottom top', scrub: true },
        });
      }

      const heroChips = document.querySelectorAll('[data-va-hero-chips] .fl-reveal-chip');
      if (heroChips.length) {
        gsap.to(heroChips, { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out', stagger: 0.08, delay: 0.3 });
      }

      const finalChips = document.querySelectorAll('[data-va-finalcta-chips] .fl-reveal-chip');
      if (finalChips.length) {
        ScrollTrigger.create({
          trigger: '[data-va-section="final-cta"]',
          start: 'top 80%',
          once: true,
          onEnter: () => {
            gsap.to(finalChips, { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out', stagger: 0.08 });
          },
        });
      }

      const steps = document.querySelectorAll('[data-va-step]');
      if (steps.length) {
        gsap.set(steps, { opacity: 0, y: 24 });
        ScrollTrigger.create({
          trigger: '[data-va-section="how-it-works"]',
          start: 'top 75%',
          once: true,
          onEnter: () => {
            gsap.to(steps, { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out', stagger: 0.12 });
          },
        });
      }

      const statEls = document.querySelectorAll('[data-stat-value]');
      statEls.forEach((el) => {
        const raw = (el as HTMLElement).dataset.statValue || '';
        const match = raw.match(/^([^\d]*)(\d[\d,]*)(.*)$/);
        if (!match) return;
        const prefix = match[1];
        const numStr = match[2].replace(/,/g, '');
        const suffix = match[3];
        const target = parseInt(numStr, 10);
        if (Number.isNaN(target) || target <= 0) return;
        const obj = { v: 0 };
        ScrollTrigger.create({
          trigger: el,
          start: 'top 85%',
          once: true,
          onEnter: () => {
            gsap.to(obj, {
              v: target,
              duration: 1.2,
              ease: 'power2.out',
              onUpdate: () => {
                const display = Math.round(obj.v).toLocaleString();
                el.textContent = `${prefix}${display}${suffix}`;
              },
              onComplete: () => { el.textContent = raw; },
            });
          },
        });
      });
    });
  }
</script>
