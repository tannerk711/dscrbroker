---
import LandingLayout from '../../layouts/LandingLayout.astro';
import LPHeader from '../../components/lp/LPHeader.astro';
import HeroCA from '../../components/lp/HeroCA.astro';
import BenefitsFL from '../../components/lp/BenefitsFL.astro';
import HowItWorksCA from '../../components/lp/HowItWorksCA.astro';
import DSCRUnderwritingReality from '../../components/lp/DSCRUnderwritingReality.astro';
import TestimonialCarouselCA from '../../components/lp/TestimonialCarouselCA.tsx';
import BarrettReviews from '../../components/lp/BarrettReviews.astro';
import SpecialistCard from '../../components/lp/SpecialistCard.astro';
import ComparisonTable from '../../components/lp/ComparisonTable.astro';
import FAQAccordion from '../../components/FAQAccordion.tsx';
import FinalCTACA from '../../components/lp/FinalCTACA.astro';
import LPFooter from '../../components/lp/LPFooter.astro';
import StickyMobileCTA from '../../components/lp/StickyMobileCTA.astro';
import { californiaFAQ } from '../../data/lp/california-faq';

const title = 'California DSCR Loans, Consultative From Day One | DSCRBroker.com';
const description = "Get matched with John Peisner at Barrett Financial, a California DSCR specialist with 1000+ closed loans. Consultative on the first call. Inland Empire, Sacramento, and Central Valley rentals, Prop 13 reassessment, no-ratio files, and declines handled. Qualify on rents, not tax returns.";

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: californiaFAQ.map((q) => ({
    '@type': 'Question',
    name: q.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: q.answer,
    },
  })),
};

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FinancialService',
  name: 'DSCRBroker.com California DSCR Specialist Matching',
  description,
  url: 'https://dscrbroker.com/lp/california-dscr/',
  areaServed: {
    '@type': 'State',
    name: 'California',
  },
  provider: {
    '@type': 'Organization',
    name: 'DSCRBroker.com',
  },
};
---

<LandingLayout
  title={title}
  description={description}
  noIndex={true}
  hideHeader={true}
  hideFooter={true}
  jsonLd={[serviceJsonLd, faqJsonLd]}
>
  <Fragment slot="head">
    <noscript>
      <style>
        .fl-reveal, .fl-reveal-chip { opacity: 1 !important; transform: none !important; }
      </style>
    </noscript>
  </Fragment>

  <LPHeader phoneNumber="(855) 738-1557" phoneLabel="Talk to a CA DSCR Specialist" />

  <HeroCA />

  <!-- Comparison up front: kills "why not go direct" while cold -->
  <ComparisonTable />

  <!-- DSCR Underwriting Reality: the spine of the page -->
  <DSCRUnderwritingReality />

  <!-- Meet John AFTER the visitor knows why DSCR is hard. Anchor panel: soft blue tint frames the section. -->
  <section data-ca-section="specialist" class="py-20 md:py-24" style="background: linear-gradient(180deg, rgba(59,130,246,0.04) 0%, rgba(59,130,246,0.07) 100%);">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <p class="text-xs font-medium uppercase tracking-[0.1em] text-amber mb-3">MEET YOUR SPECIALIST</p>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-navy">John Peisner, California DSCR Specialist</h2>
      </div>
      <SpecialistCard
        variant="full"
        theme="light"
        title="California DSCR Specialist"
        specialistLabel="Your CA Specialist"
        bio="John Peisner has closed 1000+ DSCR and non-QM loans at Barrett Financial Group, and he's the specialist California real estate investors call when their first lender said no. Consultative on the first call: he walks you through entity structuring, how Prop 13 reassessment changes your real property tax bill and your DSCR, and what the lender will actually want so you know what you're working with before you write the offer."
      />
    </div>
  </section>

  <BenefitsFL />

  <HowItWorksCA />

  <!-- CA Deal Stories: dark navy band -->
  <section data-ca-section="testimonials" class="bg-navy py-20 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <p class="text-xs font-medium uppercase tracking-[0.1em] text-amber mb-3">CALIFORNIA DEAL STORIES</p>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-white">Real California Deals, Real Outcomes</h2>
        <p class="mt-4 text-lg text-white/60 leading-relaxed max-w-3xl mx-auto">
          A snapshot of recent California deals John and his lender network closed, including the file-rescue ones other brokers walked away from.
        </p>
      </div>
      <TestimonialCarouselCA client:visible />

      <!-- CTA after the testimonial emotional peak -->
      <div class="mt-12 flex flex-col items-center gap-3 sm:gap-4 sm:flex-row sm:justify-center">
        <a
          href="#lead-form"
          data-event="scroll_to_form"
          data-location="after_testimonials"
          class="inline-flex items-center justify-center rounded-lg bg-blue px-6 py-3 text-base font-semibold text-white transition-colors hover:bg-blue-dark w-full sm:w-auto"
        >
          Match Me With John
          <svg class="ml-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a
          href="tel:8557381557"
          data-event="phone_click"
          data-location="after_testimonials"
          class="inline-flex items-center justify-center gap-2 rounded-lg border border-white/15 bg-white/[0.04] px-6 py-3 text-base font-medium text-white transition-colors hover:border-blue hover:bg-blue/10 w-full sm:w-auto"
        >
          <svg class="h-5 w-5 text-amber" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h2.28a1 1 0 01.95.68l1.5 4.49a1 1 0 01-.5 1.21l-1.86.93a11 11 0 005.2 5.2l.93-1.86a1 1 0 011.21-.5l4.49 1.5a1 1 0 01.68.95V19a2 2 0 01-2 2h-1C9.72 21 3 14.28 3 6V5z" />
          </svg>
          Call (855) 738-1557
        </a>
      </div>
    </div>
  </section>

  <!-- Live Google reviews as closing third-party trust signal -->
  <BarrettReviews state="California" />

  <!-- FAQ -->
  <section data-ca-section="faq" class="bg-off-white py-20 md:py-24">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <p class="text-xs font-medium uppercase tracking-[0.1em] text-amber mb-3">QUESTIONS</p>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-navy">California DSCR Loan Questions</h2>
        <p class="mt-4 text-base text-gray-500">The questions CA investors actually ask after their first lender said no.</p>
      </div>
      <FAQAccordion items={californiaFAQ} client:visible />

      <!-- CTA after FAQ, before final close -->
      <div class="mt-12 flex flex-col items-center gap-3 sm:gap-4 sm:flex-row sm:justify-center">
        <a
          href="#lead-form"
          data-event="scroll_to_form"
          data-location="after_faq"
          class="inline-flex items-center justify-center rounded-lg bg-blue px-6 py-3 text-base font-semibold text-white transition-colors hover:bg-blue-dark w-full sm:w-auto"
        >
          Check My CA Deal's Eligibility
          <svg class="ml-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a
          href="tel:8557381557"
          data-event="phone_click"
          data-location="after_faq"
          class="inline-flex items-center justify-center gap-2 rounded-lg border border-gray-300 bg-white px-6 py-3 text-base font-medium text-navy transition-colors hover:border-blue hover:text-blue w-full sm:w-auto"
        >
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h2.28a1 1 0 01.95.68l1.5 4.49a1 1 0 01-.5 1.21l-1.86.93a11 11 0 005.2 5.2l.93-1.86a1 1 0 011.21-.5l4.49 1.5a1 1 0 01.68.95V19a2 2 0 01-2 2h-1C9.72 21 3 14.28 3 6V5z" />
          </svg>
          Call John Direct
        </a>
      </div>
    </div>
  </section>

  <FinalCTACA phoneNumber="(855) 738-1557" />

  <LPFooter state="California" />

  <StickyMobileCTA phoneNumber="(855) 738-1557" />
</LandingLayout>

<!-- GSAP-driven motion for the CA LP. Lazy-loads gsap/ScrollTrigger via dynamic import and respects prefers-reduced-motion. -->
<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce) {
    Promise.all([
      import('gsap'),
      import('gsap/ScrollTrigger'),
    ]).then(([{ default: gsap }, { ScrollTrigger }]) => {
      gsap.registerPlugin(ScrollTrigger);

      // 1. Section enter fade-up on H2 heading blocks only (skip hero so H1 + form remain visible)
      const sections = document.querySelectorAll('[data-ca-section]:not([data-ca-section="hero"])');
      sections.forEach((section) => {
        const heading = section.querySelector('h2');
        if (!heading) return;
        const headingBlock = heading.parentElement || heading;
        gsap.set(headingBlock, { opacity: 0, y: 24 });
        ScrollTrigger.create({
          trigger: section,
          start: 'top 80%',
          once: true,
          onEnter: () => {
            gsap.to(headingBlock, {
              opacity: 1,
              y: 0,
              duration: 0.6,
              ease: 'power2.out',
            });
          },
        });
      });

      // 2. Hero parallax: ~10% translateY range on the bg image as user scrolls past hero
      const heroBg = document.getElementById('ca-hero-bg');
      if (heroBg) {
        gsap.to(heroBg, {
          yPercent: 10,
          ease: 'none',
          scrollTrigger: {
            trigger: '[data-ca-section="hero"]',
            start: 'top top',
            end: 'bottom top',
            scrub: true,
          },
        });
      }

      // 3. Hero trust chip stagger-in
      const heroChips = document.querySelectorAll('[data-ca-hero-chips] .fl-reveal-chip');
      if (heroChips.length) {
        gsap.to(heroChips, {
          opacity: 1,
          y: 0,
          duration: 0.5,
          ease: 'power2.out',
          stagger: 0.08,
          delay: 0.3,
        });
      }

      // 4. FinalCTA chip stagger-in (on scroll trigger)
      const finalChips = document.querySelectorAll('[data-ca-finalcta-chips] .fl-reveal-chip');
      if (finalChips.length) {
        ScrollTrigger.create({
          trigger: '[data-ca-section="final-cta"]',
          start: 'top 80%',
          once: true,
          onEnter: () => {
            gsap.to(finalChips, {
              opacity: 1,
              y: 0,
              duration: 0.5,
              ease: 'power2.out',
              stagger: 0.08,
            });
          },
        });
      }

      // 5. HowItWorks step stagger fade-up
      const steps = document.querySelectorAll('[data-ca-step]');
      if (steps.length) {
        gsap.set(steps, { opacity: 0, y: 24 });
        ScrollTrigger.create({
          trigger: '[data-ca-section="how-it-works"]',
          start: 'top 75%',
          once: true,
          onEnter: () => {
            gsap.to(steps, {
              opacity: 1,
              y: 0,
              duration: 0.6,
              ease: 'power2.out',
              stagger: 0.12,
            });
          },
        });
      }

      // 6. Specialist stat count-up animation
      const statEls = document.querySelectorAll('[data-stat-value]');
      statEls.forEach((el) => {
        const raw = (el as HTMLElement).dataset.statValue || '';
        const match = raw.match(/^([^\d]*)(\d[\d,]*)(.*)$/);
        if (!match) return;
        const prefix = match[1];
        const numStr = match[2].replace(/,/g, '');
        const suffix = match[3];
        const target = parseInt(numStr, 10);
        if (Number.isNaN(target) || target <= 0) return;
        const obj = { v: 0 };
        ScrollTrigger.create({
          trigger: el,
          start: 'top 85%',
          once: true,
          onEnter: () => {
            gsap.to(obj, {
              v: target,
              duration: 1.2,
              ease: 'power2.out',
              onUpdate: () => {
                const display = Math.round(obj.v).toLocaleString();
                el.textContent = `${prefix}${display}${suffix}`;
              },
              onComplete: () => {
                el.textContent = raw;
              },
            });
          },
        });
      });
    });
  }
</script>
