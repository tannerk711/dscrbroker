---
import StateLayout from '../../layouts/StateLayout.astro';
import statesData from '../../data/states.json';

export function getStaticPaths() {
  return statesData.map((s: any) => ({
    params: { state: s.slug },
    props: { stateData: s },
  }));
}

const { stateData } = Astro.props;

// City pages (gated: only states with a data file in src/data/cities/ render the
// "DSCR Loans by City" section; see src/data/cities/README.md)
const cityModules = import.meta.glob('../../data/cities/*.json', { eager: true });
const cityFile: any = Object.values(cityModules)
  .map((mod: any) => (mod as any).default)
  .find((f: any) => f.stateSlug === stateData.slug);
const cityPages = (cityFile?.cities || []).map((ct: any) => ({
  city: ct.city,
  slug: ct.slug,
  medianPrice: ct.market.medianPrice,
  medianRent: ct.market.medianRent,
  estDSCR: ct.market.estDSCR,
}));

// Build related states data from slugs
const relatedStates = (stateData.relatedStates || [])
  .map((slug: string) => statesData.find((s: any) => s.slug === slug))
  .filter(Boolean)
  .map((s: any) => ({
    state: s.state,
    slug: s.slug,
    medianHomePrice: s.medianHomePrice,
    medianRent: s.medianRent,
  }));

// Meta description: authored per state in states.json (140-160 chars, unique; the
// verify script enforces both).
const metaDescription = stateData.metaAngle;

// Build title
const title = `DSCR Loans in ${stateData.state} | Licensed Specialist | DSCRBroker.com`;

// Build JSON-LD (3 schemas: FinancialService, FAQPage, BreadcrumbList)
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "FinancialService",
    "name": `DSCR Loans in ${stateData.state} | DSCRBroker.com`,
    "url": `https://dscrbroker.com/states/${stateData.slug}/`,
    "description": `DSCR loans in ${stateData.state} structured by licensed DSCR specialists. Access to 70+ lenders. No income documentation required.`,
    "serviceType": "DSCR Loan Broker Matching",
    "areaServed": {
      "@type": "State",
      "name": stateData.state,
      "containedInPlace": {
        "@type": "Country",
        "name": "United States"
      }
    },
    "provider": {
      "@type": "Organization",
      "name": "DSCRBroker.com",
      "url": "https://dscrbroker.com"
    },
    "offers": {
      "@type": "AggregateOffer",
      "priceCurrency": "USD",
      "lowPrice": "75000",
      "highPrice": "3000000",
      "offerCount": "8"
    },
    "address": {
      "@type": "PostalAddress",
      "addressRegion": stateData.abbreviation,
      "addressCountry": "US"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": stateData.faqItems.map((item: any) => ({
      "@type": "Question",
      "name": item.question,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": item.answer
      }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://dscrbroker.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "States",
        "item": "https://dscrbroker.com/states/"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": `DSCR Loans in ${stateData.state}`,
        "item": `https://dscrbroker.com/states/${stateData.slug}/`
      }
    ]
  }
];
---

<StateLayout
  title={title}
  description={metaDescription}
  slug={stateData.slug}
  abbreviation={stateData.abbreviation}
  state={stateData.state}
  stateHook={stateData.stateHook}
  medianHomePrice={stateData.medianHomePrice}
  medianRent={stateData.medianRent}
  estimatedDSCR={stateData.estimatedDSCR}
  marketOverview={stateData.marketOverview}
  landlordFriendly={stateData.landlordFriendly}
  propertyTaxRate={stateData.propertyTaxRate}
  topCities={stateData.topCities}
  commonPropertyTypes={stateData.commonPropertyTypes}
  licensingNote={stateData.licensingNote}
  dealExample={stateData.dealExample}
  faqItems={stateData.faqItems}
  relatedStates={relatedStates}
  cityPages={cityPages}
  jsonLd={jsonLd}
/>
