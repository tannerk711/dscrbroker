---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found | DSCRBroker.com"
  description="That page does not exist. Find DSCR loan programs, state guides, or match with a licensed DSCR specialist."
  noIndex={true}
>
  <section class="bg-navy min-h-[calc(100vh-72px)] flex items-center">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 py-24 md:py-32 text-center">
      <p class="text-amber text-sm font-semibold uppercase tracking-[0.2em] mb-4">404</p>
      <h1 class="text-3xl md:text-5xl font-extrabold text-white leading-tight mb-4">
        This page does not exist.
      </h1>
      <p class="text-white/60 text-lg mb-10 max-w-xl mx-auto">
        The link may be old or mistyped. Your deal is still easy to place, start with one of these.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href="/qualify/"
          class="w-full sm:w-auto bg-blue hover:bg-blue/90 text-white font-semibold text-sm uppercase tracking-wider rounded px-8 py-4 transition-colors duration-150"
        >
          Match Me With a Specialist
        </a>
        <a
          href="/"
          class="w-full sm:w-auto bg-white/5 hover:bg-white/10 border border-white/10 text-white font-semibold text-sm uppercase tracking-wider rounded px-8 py-4 transition-colors duration-150"
        >
          Back to Homepage
        </a>
      </div>
      <div class="mt-12 pt-8 border-t border-white/10 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-sm">
        <a href="/programs/" class="text-white/50 hover:text-white transition-colors">Loan Programs</a>
        <a href="/states/" class="text-white/50 hover:text-white transition-colors">DSCR Loans by State</a>
        <a href="/analyze/" class="text-white/50 hover:text-white transition-colors">Deal Analyzer</a>
      </div>
    </div>
  </section>
</BaseLayout>
