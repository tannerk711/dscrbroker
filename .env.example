# DSCRBroker.com Environment Variables

# RentCast API (Deal Analyzer URL mode)
RENTCAST_API_KEY=

# Google Tag Manager
PUBLIC_GTM_ID=

# Webhook URLs for broker routing (Zapier Catch Hook -> GoHighLevel).
# All five currently point at the same hook (every state routes to John today).
# Put the REAL url in .env (gitignored) and in Vercel env vars, NOT here.
WEBHOOK_BROKER_A=https://hooks.zapier.com/hooks/catch/XXXXXXX/yyyyyyy/
WEBHOOK_BROKER_B=https://hooks.zapier.com/hooks/catch/XXXXXXX/yyyyyyy/
WEBHOOK_BROKER_C=https://hooks.zapier.com/hooks/catch/XXXXXXX/yyyyyyy/
WEBHOOK_BROKER_D=https://hooks.zapier.com/hooks/catch/XXXXXXX/yyyyyyy/
WEBHOOK_BROKER_E=https://hooks.zapier.com/hooks/catch/XXXXXXX/yyyyyyy/

# Site URL (used for canonical tags, OG tags)
PUBLIC_SITE_URL=https://dscrbroker.com
